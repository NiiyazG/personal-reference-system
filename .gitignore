# Generated bytecode from test and CLI runs.
__pycache__/
*.py[cod]

# The reference corpus itself: manifest, SQLite database, immutable blobs,
# derived artifacts and reports. Never commit or publish this — it is the
# user's private material and is intentionally not backed up.
data/

# A local configuration file may name a storage root and quotas specific to
# one machine. The tracked example is reference.config.example.json.
reference.config.json

# Local virtual environments, if one is ever created here.
.venv/
venv/
